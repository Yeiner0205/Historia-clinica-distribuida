      "item": [
        {
          "name": "Entrar como paciente1007",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api}}/auth/login",
              "host": [
                "{{api}}/auth/login"
              ]
            },
            "description": "Devuelve el token del rol y lo guarda en la variable {{tok_paciente}}.",
            "body": {
              "mode": "raw",
              "raw": "{\"usuario\": \"paciente1007\", \"password\": \"paciente123\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tok_paciente\", pm.response.json().access_token);",
                  "pm.test(\"trae rol y permisos\", () => {",
                  "    const d = pm.response.json();",
                  "    pm.expect(d).to.have.property(\"rol\");",
                  "    pm.expect(d.permisos).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ]
