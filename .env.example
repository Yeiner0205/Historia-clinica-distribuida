# ============================================================================
# Variables de entorno de la plataforma.
#
# Copie este archivo como `.env` (que NO se versiona) y cambie los valores:
#     cp .env.example .env
#
# «Guardar secretos en el repositorio» es uno de los errores frecuentes que
# señala la guía: aquí solo hay valores de ejemplo para la demostración.
# ============================================================================

# ── Seguridad ───────────────────────────────────────────────────────────────
# Secreto con el que se firman los tokens JWT. Cámbielo siempre.
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio
JWT_HORAS=8

# Claves de los usuarios sintéticos de prueba (ver README).
PWD_PACIENTE=paciente123
PWD_ADMISION=admision123
PWD_MEDICO=medico123
PWD_AUDITOR=auditor123

# ── Bases de datos ──────────────────────────────────────────────────────────
PG_USER=admin
PG_PASSWORD=admin
PG_DB_SEDE=historia_clinica
PG_CENTRAL_DB=hsb

# ── Comportamiento del bus ──────────────────────────────────────────────────
# Máximo de intentos antes de pasar a la cola de mensajes muertos.
HSB_MAX_INTENTOS=4
# Espera base del retroceso exponencial en segundos (1s, 2s, 4s, 8s…).
HSB_ESPERA_BASE_S=1
# Cada cuánto revisa la cola el trabajador de fondo.
HSB_INTERVALO_TRABAJADOR_S=2
# En HL7 v2 el diagnóstico debe venir en CIE-10 (ver docs/decisiones).
HSB_HL7_EXIGE_CIE10=true

# ── Registro ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
