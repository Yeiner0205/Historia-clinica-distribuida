{
  "_comentario": "Realm de demostración de la plataforma de interoperabilidad clínica. Datos sintéticos. Las claves son de prueba y deben cambiarse antes de cualquier uso real. SIN PROBAR: ver infra/keycloak/LEEME.md.",
  "realm": "historia-clinica",
  "enabled": true,
  "displayName": "Plataforma distribuida de interoperabilidad clínica",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 28800,
  "roles": {
    "realm": [
      {
        "name": "paciente",
        "description": "Ve su propia historia y su Bundle FHIR"
      },
      {
        "name": "admisionista",
        "description": "Busca, registra y abre atenciones; no ve contenido clínico"
      },
      {
        "name": "medico",
        "description": "Consulta la historia unificada y escribe contenido clínico"
      },
      {
        "name": "auditor",
        "description": "Audita, opera el bus y controla los nodos"
      }
    ]
  },
  "clients": [
    {
      "clientId": "plataforma-hc",
      "name": "Plataforma de interoperabilidad clínica",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8001/*"
      ],
      "webOrigins": [
        "http://localhost:8001"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "documento",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "documento",
            "claim.name": "documento",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "sede_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "sede_id",
            "claim.name": "sede_id",
            "jsonType.label": "int",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "audiencia",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "plataforma-hc",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
